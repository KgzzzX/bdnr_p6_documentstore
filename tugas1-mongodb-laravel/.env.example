APP_NAME="Perpustakaan MongoDB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Sesuai Aturan Slide 16 & Bug 2:
# DB_CONNECTION default tetap sqlite, session driver menggunakan file
DB_CONNECTION=sqlite
SESSION_DRIVER=file

# Konfigurasi Koneksi MongoDB Lokal
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=perpustakaan_db

